// Prisma schema for OpenClockwork.
//
// Single source of truth for the PostgreSQL database. Migrations are tracked
// under prisma/migrations/ and must be checked into git. Never edit a migration
// after it has been merged to main; create a new one instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------

enum Role {
  Employee
  Manager
  HRAdmin
}

enum OperatingMode {
  Team
  Solo
}

enum TimeModel {
  Teilzeit
  Vollzeit
  Vertrauensarbeitszeit
  Gleitzeit
}

enum EntrySource {
  Manual
  Pwa
  Terminal
  Erp
  DailyBlock
}

enum EntryStatus {
  Open
  Pending
  Approved
  Rejected
}

enum RequestType {
  Vacation
  HomeOffice
  SpecialLeave
  TimeAdjustment
}

enum RequestStatus {
  Submitted
  Approved
  Rejected
  Cancelled
}

enum WorkflowState {
  Draft
  Submitted
  PendingSubstitute
  PendingManager
  PendingHr
  Approved
  Rejected
  Cancelled
}

enum RequestEventKind {
  Submitted
  SubstituteAccepted
  SubstituteDeclined
  ManagerApproved
  ManagerRejected
  Returned
  Resubmitted
  HrConfirmed
  HrRejected
  Cancelled
}

enum ThemePreference {
  Light
  Dark
  System
}

enum AbsenceKind {
  // Absence kinds are intentionally limited. Adding kinds requires a migration
  // so API/UI/reporting stay explicit.
  Sickness
  Training
  Flextime
}

// -------------------------------------------------------------
// Models
// -------------------------------------------------------------

model Employee {
  id                            String                        @id @default(uuid()) @db.Uuid
  personalNo                    String                        @unique
  firstName                     String
  lastName                      String
  email                         String                        @unique
  passwordHash                  String
  authVersion                   Int                           @default(0)
  role                          Role                          @default(Employee)
  timeModel                     TimeModel
  weeklyHours                   Decimal                       @db.Decimal(5, 2)
  annualLeaveDays               Decimal                       @db.Decimal(5, 2)
  startDate                     DateTime                      @db.Date
  overtimeOpeningBalanceMinutes Int                           @default(0)
  /// Legacy German state alias, retained for API compatibility.
  bundesland                    String?                       @db.VarChar(2)
  /// Explicit optional holiday preset; NONE assumes no public holidays.
  holidayCalendar               String                        @default("NONE") @db.VarChar(20)
  /// Explicit non-working dates (YYYY-MM-DD), supplementing the selected preset.
  holidayDates                  String[]                      @default([])
  /// User-facing dark/light mode preference. "System" follows the OS setting.
  themePreference               ThemePreference               @default(System)
  /// Allows an employee to create one self-approved fixed-duration block per working day.
  allowDailyBlockBooking        Boolean                       @default(false)
  isActive                      Boolean                       @default(true)
  managerId                     String?                       @db.Uuid
  manager                       Employee?                     @relation("ManagerToReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports                       Employee[]                    @relation("ManagerToReports")
  workScheduleId                String?                       @db.Uuid
  workSchedule                  WorkSchedule?                 @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  timeEntries                   TimeEntry[]
  requests                      Request[]                     @relation("RequestEmployee")
  approverRequests              Request[]                     @relation("RequestApprover")
  decidedRequests               Request[]                     @relation("RequestDecider")
  substituteRequests            Request[]                     @relation("RequestSubstitute")
  leaveAllowances               EmployeeLeaveAllowance[]
  events                        RequestEvent[]                @relation("EventActor")
  uploadedAttachments           RequestAttachment[]
  absences                      Absence[]
  projectAssignments            ProjectAssignment[]
  terminalChallengeRedemptions  TerminalChallengeRedemption[]
  ownedInstallation             InstallationSettings?
  soloPolicies                  SoloPolicy[]
  personalDays                  PersonalDay[]
  timeEntryAudits                TimeEntryAudit[]
  installationEvents            InstallationEvent[]
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt

  @@index([role])
  @@index([managerId])
  @@index([workScheduleId])
}

// Frame and core working hours. A schedule is assigned per Employee
// (Employee.workScheduleId). Multiple core-time windows per schedule are
// supported (e.g. 10:00–11:00 and 14:00–15:00). Times are stored as checked
// "HH:mm" strings; weekdays as a checked 7-bit mask (Mon=1, Tue=2, ..., Sun=64).
model WorkSchedule {
  id          String                 @id @default(uuid()) @db.Uuid
  name        String                 @unique
  description String?
  frameStart  String                 @db.VarChar(5) // "HH:mm" — start of permitted booking window
  frameEnd    String                 @db.VarChar(5) // "HH:mm" — end of permitted booking window
  isDefault   Boolean                @default(false)
  /// Working-days bitmask (Mon=1, Tue=2, ..., Sun=64). Default 31 = Mo–Fr.
  /// Days outside the mask are non-working for Soll/Vacation accounting.
  workingDays Int                    @default(31)
  /// Configurable total automatic deductions at inclusive attendance thresholds.
  breakRules  Json                   @default("[]")
  coreTimes   WorkScheduleCoreTime[]
  employees   Employee[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model WorkScheduleCoreTime {
  id         String       @id @default(uuid()) @db.Uuid
  scheduleId String       @db.Uuid
  schedule   WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  label      String?
  start      String       @db.VarChar(5) // "HH:mm"
  end        String       @db.VarChar(5) // "HH:mm"
  weekdays   Int          @default(31) // bitmask Mon=1, Tue=2, Wed=4, Thu=8, Fri=16, Sat=32, Sun=64

  @@index([scheduleId])
}

model TimeEntry {
  id                                String                        @id @default(uuid()) @db.Uuid
  employeeId                        String                        @db.Uuid
  employee                          Employee                      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  clockIn                           DateTime
  clockOut                          DateTime?
  source                            EntrySource                   @default(Manual)
  status                            EntryStatus                   @default(Open)
  requiresApproval                  Boolean                       @default(false)
  billable                          Boolean                       @default(false)
  revision                          Int                           @default(0)
  voidedAt                          DateTime?
  /// Project switches/splits retain one capture group and its break policy.
  captureGroupId                    String?                       @db.Uuid
  /// Historical null values retain Team approval semantics.
  approvalMode                      String?
  auditEvents                       TimeEntryAudit[]
  /// Policy snapshot captured at booking; later schedule changes do not rewrite history.
  breakRules                        Json                          @default("[]")
  latitude                          Decimal?                      @db.Decimal(9, 6)
  longitude                         Decimal?                      @db.Decimal(9, 6)
  accuracyMeters                    Decimal?                      @db.Decimal(7, 2)
  terminalDistanceMeters            Decimal?                      @db.Decimal(8, 2)
  terminalRadiusMeters              Int?
  terminalMaxAccuracyMeters         Int?
  positionTimestamp                 DateTime?
  /// Visible terminal location captured when clock-in was accepted.
  terminalLocationLabel             String?                       @db.VarChar(200)
  clockOutLatitude                  Decimal?                      @db.Decimal(9, 6)
  clockOutLongitude                 Decimal?                      @db.Decimal(9, 6)
  clockOutAccuracyMeters            Decimal?                      @db.Decimal(7, 2)
  clockOutTerminalDistanceMeters    Decimal?                      @db.Decimal(8, 2)
  clockOutTerminalRadiusMeters      Int?
  clockOutTerminalMaxAccuracyMeters Int?
  clockOutPositionTimestamp         DateTime?
  /// Visible terminal location captured when clock-out was accepted.
  clockOutTerminalLocationLabel     String?                       @db.VarChar(200)
  /// Terminal used for the physical clock-in. Null for non-terminal entries.
  terminalId                        String?                       @db.Uuid
  terminal                          Terminal?                     @relation("TerminalClockInEntries", fields: [terminalId], references: [id], onDelete: SetNull)
  /// A clock-out may happen at a different terminal (or close a PWA entry).
  clockOutTerminalId                String?                       @db.Uuid
  clockOutTerminal                  Terminal?                     @relation("TerminalClockOutEntries", fields: [clockOutTerminalId], references: [id], onDelete: SetNull)
  clockInChallengeId                String?                       @db.Uuid
  clockInChallenge                  TerminalChallenge?            @relation("TerminalChallengeClockIn", fields: [clockInChallengeId], references: [id], onDelete: SetNull)
  clockOutChallengeId               String?                       @db.Uuid
  clockOutChallenge                 TerminalChallenge?            @relation("TerminalChallengeClockOut", fields: [clockOutChallengeId], references: [id], onDelete: SetNull)
  terminalChallengeRedemptions      TerminalChallengeRedemption[]
  note                              String?
  projectId                         String?                       @db.Uuid
  project                           Project?                      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  serviceOrderId                    String?                       @db.Uuid
  serviceOrder                      ServiceOrder?                 @relation(fields: [projectId, serviceOrderId], references: [projectId, id], onDelete: Restrict)
  /// Customer-facing description of the work performed (Tätigkeit).
  activity                          String?
  /// Local calendar date for DailyBlock entries. Null for all other entry sources.
  bookingDate                       DateTime?                     @db.Date
  createdAt                         DateTime                      @default(now())
  updatedAt                         DateTime                      @updatedAt

  @@unique([employeeId, bookingDate])
  @@index([employeeId, clockIn])
  @@index([captureGroupId])
  @@index([status])
  @@index([projectId])
  @@index([serviceOrderId])
  @@index([terminalId])
  @@index([clockOutTerminalId])
  @@index([clockInChallengeId])
  @@index([clockOutChallengeId])
}

/// A configured, wall-mounted time-clock display. Deactivation is reversible;
/// permanent deletion removes kiosk-only data while TimeEntry audit snapshots remain.
model Terminal {
  id                String              @id @default(uuid()) @db.Uuid
  name              String              @db.VarChar(120)
  displayText       String              @db.VarChar(500)
  locationLabel     String              @db.VarChar(200)
  logoUrl           String?
  enforceGeofence   Boolean             @default(true)
  latitude          Decimal?            @db.Decimal(9, 6)
  longitude         Decimal?            @db.Decimal(9, 6)
  radiusMeters      Int?
  maxAccuracyMeters Int?
  timeZone          String              @default("UTC") @db.VarChar(100)
  isActive          Boolean             @default(false)
  activatedAt       DateTime?
  pairingCodeHash   String?             @unique @db.Char(64)
  pairingExpiresAt  DateTime?
  devices           TerminalDevice[]
  challenges        TerminalChallenge[]
  clockInEntries    TimeEntry[]         @relation("TerminalClockInEntries")
  clockOutEntries   TimeEntry[]         @relation("TerminalClockOutEntries")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([isActive])
}

/// A separately authenticated kiosk installation. Only a hash of the bearer
/// credential is persisted so a database read does not reveal device tokens.
model TerminalDevice {
  id         String              @id @default(uuid()) @db.Uuid
  terminalId String              @db.Uuid
  terminal   Terminal            @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  name       String?             @db.VarChar(120)
  tokenHash  String              @unique @db.Char(64)
  lastSeenAt DateTime?
  revokedAt  DateTime?
  challenges TerminalChallenge[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([terminalId, revokedAt])
}

/// One opaque, short-lived QR challenge. Redemptions are recorded atomically;
/// each employee may use the displayed challenge at most once.
model TerminalChallenge {
  id                  String                        @id @default(uuid()) @db.Uuid
  terminalId          String                        @db.Uuid
  terminal            Terminal                      @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  deviceId            String                        @db.Uuid
  device              TerminalDevice                @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenHash           String                        @unique @db.Char(64)
  rootDate            DateTime                      @db.Date
  expiresAt           DateTime
  redemptions         TerminalChallengeRedemption[]
  clockInTimeEntries  TimeEntry[]                   @relation("TerminalChallengeClockIn")
  clockOutTimeEntries TimeEntry[]                   @relation("TerminalChallengeClockOut")
  createdAt           DateTime                      @default(now())

  @@index([terminalId, expiresAt])
  @@index([deviceId, expiresAt])
  @@index([deviceId, createdAt])
}

/// Per-employee replay protection for a display challenge. The challenge may
/// be used by many employees, but never twice by the same employee.
model TerminalChallengeRedemption {
  id          String            @id @default(uuid()) @db.Uuid
  challengeId String            @db.Uuid
  challenge   TerminalChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  employeeId  String            @db.Uuid
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  timeEntryId String            @db.Uuid
  timeEntry   TimeEntry         @relation(fields: [timeEntryId], references: [id], onDelete: Restrict)
  action      String            @db.VarChar(9)
  createdAt   DateTime          @default(now())

  @@unique([challengeId, employeeId])
  @@index([employeeId, createdAt])
  @@index([timeEntryId])
}

/// Installation-wide acknowledgement for the optional support prompt. No
/// payment, sponsor, or declined-state is stored here.
model TerminalSupportPrompt {
  id               Int       @id @default(1)
  firstActivatedAt DateTime
  shownAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Request {
  id                   String              @id @default(uuid()) @db.Uuid
  employeeId           String              @db.Uuid
  employee             Employee            @relation("RequestEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  type                 RequestType
  status               RequestStatus       @default(Submitted)
  workflowState        WorkflowState       @default(Submitted)
  from                 DateTime
  to                   DateTime
  reason               String?
  requiresApproval     Boolean             @default(false)
  calculatedDays       Decimal             @default(0) @db.Decimal(6, 2)
  halfDayStart         Boolean             @default(false)
  halfDayEnd           Boolean             @default(false)
  substituteId         String?             @db.Uuid
  substitute           Employee?           @relation("RequestSubstitute", fields: [substituteId], references: [id], onDelete: SetNull)
  substituteAcceptedAt DateTime?
  currentApproverId    String?             @db.Uuid
  currentApprover      Employee?           @relation("RequestApprover", fields: [currentApproverId], references: [id], onDelete: SetNull)
  approverId           String?             @db.Uuid
  approver             Employee?           @relation("RequestDecider", fields: [approverId], references: [id], onDelete: SetNull)
  hrConfirmedAt        DateTime?
  cancelledAt          DateTime?
  decidedAt            DateTime?
  decisionNote         String?
  events               RequestEvent[]
  attachments          RequestAttachment[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([employeeId, workflowState])
  @@index([currentApproverId])
  @@index([approverId])
  @@index([substituteId])
}

// Files attached to a request — currently only used for Sonderurlaub
// (SpecialLeave) where a Beleg is often required. Bytes live in the
// configured StorageAdapter (local FS in dev, Blob in Azure); the DB
// row carries metadata and the opaque storage key.
model RequestAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  requestId    String   @db.Uuid
  request      Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  uploadedById String   @db.Uuid
  uploadedBy   Employee @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([requestId])
}

model RequestEvent {
  id         String           @id @default(uuid()) @db.Uuid
  requestId  String           @db.Uuid
  request    Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind       RequestEventKind
  actorId    String?          @db.Uuid
  actor      Employee?        @relation("EventActor", fields: [actorId], references: [id], onDelete: SetNull)
  note       String?
  occurredAt DateTime         @default(now())

  @@index([requestId, occurredAt])
}

model Absence {
  id         String      @id @default(uuid()) @db.Uuid
  employeeId String      @db.Uuid
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  kind       AbsenceKind @default(Sickness)
  from       DateTime    @db.Date
  to         DateTime    @db.Date
  certified  Boolean     @default(false)
  note       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([employeeId, from])
  @@index([kind, from])
}

// Projects are the booking targets for project time capture (Epic 5).
// Time is booked on the project level only; service orders structure a
// project for admins but are never referenced by time entries. Projects
// with booked time entries cannot be hard-deleted (onDelete: Restrict on
// TimeEntry.project) — deactivate them via isActive instead.
model Project {
  id            String              @id @default(uuid()) @db.Uuid
  /// Short unique project code ("PRJ-001"); exposed in the ERP export.
  code          String              @unique
  name          String
  description   String?
  customerId    String?             @db.Uuid
  customer      Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  defaultBillable Boolean           @default(false)
  isActive      Boolean             @default(true)
  /// Planned effort in hours; null = no plan defined. The sum of the
  /// service-order planHours must not exceed this (service-enforced).
  planHours     Decimal?            @db.Decimal(8, 2)
  serviceOrders ServiceOrder[]
  assignments   ProjectAssignment[]
  timeEntries   TimeEntry[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([isActive])
  @@index([customerId])
}

model ServiceOrder {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @db.Uuid
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orderNo     String
  title       String
  defaultBillable Boolean?
  isActive    Boolean     @default(true)
  /// Planned effort in hours; null = no plan defined.
  planHours   Decimal?    @db.Decimal(8, 2)
  timeEntries TimeEntry[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([projectId, orderNo])
  @@unique([projectId, id])
  @@index([projectId])
}

// Hard booking authorization: only assigned employees may book time on a
// project. The admin matrix toggles these rows; the API validates on
// clock-in, retroactive assignment, and split.
model ProjectAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  projectId  String   @db.Uuid
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([employeeId, projectId])
  @@index([projectId])
}

model EmployeeLeaveAllowance {
  id                 String    @id @default(uuid()) @db.Uuid
  employeeId         String    @db.Uuid
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  year               Int
  baseDays           Decimal   @db.Decimal(5, 2)
  carryOverDays      Decimal   @default(0) @db.Decimal(5, 2)
  carryOverExpiresOn DateTime? @db.Date
  adjustmentDays     Decimal   @default(0) @db.Decimal(5, 2)
  adjustmentReason   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([employeeId, year])
}

/// One operating mode per installation; upgrades explicitly retain Team mode.
model InstallationSettings {
  id              Int           @id @default(1)
  mode            OperatingMode @default(Team)
  ownerEmployeeId String?       @unique @db.Uuid
  owner           Employee?     @relation(fields: [ownerEmployeeId], references: [id], onDelete: Restrict)
  setupCompleted  Boolean       @default(false)
  revision        Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

/// Effective-date versions preserve past personal targets and calendar rules.
model SoloPolicy {
  id                    String   @id @default(uuid()) @db.Uuid
  employeeId            String   @db.Uuid
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  effectiveFrom         DateTime @db.Date
  targetEnabled         Boolean  @default(false)
  weeklyTargetMinutes   Int?
  workingDays           Int      @default(31)
  leaveEnabled          Boolean  @default(false)
  annualLeaveDays       Decimal  @default(0) @db.Decimal(5, 2)
  carryOverDays         Decimal  @default(0) @db.Decimal(5, 2)
  carryOverExpiresOn    DateTime? @db.Date
  leaveAdjustmentDays  Decimal  @default(0) @db.Decimal(5, 2)
  leaveAdjustmentReason String?
  leaveAllowanceYear    Int?
  holidayCalendar       String   @default("NONE")
  holidayDates          String[] @default([])
  breakRules            Json     @default("[]")
  coreTimeHintsEnabled  Boolean  @default(false)
  frameStart            String   @default("00:00") @db.VarChar(5)
  frameEnd              String   @default("23:59") @db.VarChar(5)
  coreTimes             Json     @default("[]")
  dailyBlockEnabled     Boolean  @default(false)
  gpsEnabled            Boolean  @default(false)
  createdAt             DateTime @default(now())

  @@index([employeeId, effectiveFrom, createdAt])
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  code      String?   @unique
  note      String?
  isActive  Boolean   @default(true)
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TimeEntryAudit {
  id          String    @id @default(uuid()) @db.Uuid
  timeEntryId String    @db.Uuid
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Restrict)
  actorId     String?   @db.Uuid
  actor       Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  before      Json?
  after       Json?
  reason      String?
  occurredAt  DateTime  @default(now())

  @@index([timeEntryId, occurredAt])
}

model PersonalDay {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String    @db.Uuid
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  kind         String
  from         DateTime  @db.Date
  to           DateTime  @db.Date
  note         String?
  halfDayStart Boolean   @default(false)
  halfDayEnd   Boolean   @default(false)
  revision     Int       @default(0)
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([employeeId, from])
}

model InstallationEvent {
  id         String    @id @default(uuid()) @db.Uuid
  actorId    String?   @db.Uuid
  actor      Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  before     Json?
  after      Json?
  occurredAt DateTime  @default(now())

  @@index([occurredAt])
}
