# OpenClockwork local iPad/LAN test configuration.
#
# Copy to .env.ipad, replace the example address with this Mac's current LAN
# address, then follow docs/IPAD_TERMINAL_SETUP.de.md. .env.ipad and all files
# below .certs/ are ignored by Git.

# Exact browser origin used by the iPad: scheme + LAN host + port, without a
# trailing slash or path. This value is the LAN entry in the API's narrow CORS
# allow-list; the overlay additionally permits only its loopback web origins.
IPAD_ORIGIN=https://192.168.178.42:8443

# HTTPS gateway port exposed to the local network. Keep 0.0.0.0 only on a
# trusted test LAN; host firewall rules should limit access accordingly.
IPAD_HTTPS_BIND_ADDRESS=0.0.0.0
IPAD_HTTPS_PORT=8443

# Certificate containing the IP address/hostname from IPAD_ORIGIN as a SAN.
# Generate both files with ops/generate-ipad-tls.sh; never commit them.
IPAD_TLS_CERT_FILE=./.certs/ipad/openclockwork-ipad.pem
IPAD_TLS_KEY_FILE=./.certs/ipad/openclockwork-ipad-key.pem

# Keep direct database/API/HTTP mappings private to the Docker host.
DEV_BIND_ADDRESS=127.0.0.1
DB_PORT=5432
API_PORT=3001
WEB_PORT=8080

# The iPad stack uses only synthetic seed data and therefore enables the
# pre-filled demo login.
DEMO_MODE=true

# Optional voluntary-support destination. Empty hides the button without
# changing terminal availability.
SUPPORT_URL=https://github.com/sponsors/patrickschiller

# Local development credentials. Use independent random values when the test
# network is shared with devices or people you do not control.
POSTGRES_USER=openclockwork
POSTGRES_PASSWORD=openclockwork
POSTGRES_DB=openclockwork
TZ=Europe/Berlin
JWT_SECRET=change-me-jwt-secret
TERMINAL_QR_SECRET=change-me-independent-terminal-qr-secret
TERMINAL_CHALLENGE_TTL_SECONDS=45
TERMINAL_PAIRING_TTL_SECONDS=600
ERP_API_KEY=dev-erp-key
CRON_API_KEY=dev-cron-key
