{
  "name": "api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "api"
    ],
    "targets": {
      "test-ops": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --test ops/*.test.mjs",
          "cwd": "."
        }
      },
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "apps/api-e2e/jest.config.js",
          "passWithNoTests": true,
          "runInBand": true
        }
      }
    }
  }
}
